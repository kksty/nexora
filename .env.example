# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# docker compose 会自动读取它，未设置的项使用 compose.yaml 里的默认值。

# 固定 Web UI 访问令牌（至少 8 个字符）。留空则每次启动随机生成，
# 用 `docker compose logs web` 查看。
# LIEBIAN_WEB_TOKEN=replace-with-a-long-random-token

# 模型配置。优先级：前端弹窗里填的 > 前端保存的（tasks/.web-settings.json）
# > 这里的环境变量 > 内置默认值。保存过前端配置后，它以整份覆盖环境变量；
# 想重新交给环境变量，在弹窗里点“回退到环境变量”。
#
# LIEBIAN_API_KEY / LIEBIAN_BASE_URL 是推荐的名字，适用于任何 OpenAI 兼容网关
# （自建 vLLM、厂商代理、PAI 等）。DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 仍被
# 识别，作为旧名兼容。
LIEBIAN_API_KEY=
# LIEBIAN_BASE_URL=http://192.168.1.10:8080/v1

# Provider 是自由文本，不限于 deepseek-official；非 deepseek-official 时必须
# 提供 Base URL。Model 必须是该网关真实存在的模型 id。
LIEBIAN_PROVIDER=deepseek-official
LIEBIAN_MODEL=deepseek-flash
LIEBIAN_MODEL_CONCURRENCY=4
# 单次模型响应的输出上限。SDK 默认用官方 DeepSeek 的 256000，但很多第三方网关
# 上限更低，且超限时可能不报错、直接返回空回复（表现为执行者“不干活”）。
# 默认 32000，够一次工具调用；网关上限更小时可继续调低。
LIEBIAN_MODEL_MAX_TOKENS=32000
# 思考强度：off / low / high / max（默认 high）。off 会发送 thinking:disabled。
# 是否真的生效取决于模型和网关：实测该网关只认「开/关」，effort 档位差异不明显；
# 个别模型（如 k3-256k）关闭思考后会返回空回复，切换前先确认模型支持。
# LIEBIAN_MODEL_THINKING=high
LIEBIAN_MODEL_STREAM_IDLE_MS=120000
LIEBIAN_DIAGNOSTICS_INTERVAL_MS=30000
LIEBIAN_DIAGNOSTICS_MAX_BYTES=16777216
LIEBIAN_DIAGNOSTICS_FILES=8

# Web 与任务容器统一使用 host 网络。Windows Docker Desktop 须启用 host networking。
# 仅本机访问使用 127.0.0.1；局域网/VPS 访问可设为 0.0.0.0。
LIEBIAN_WEB_HOST=127.0.0.1
LIEBIAN_WEB_PORT=43187
# 多个任务各自从该范围原子绑定一个空闲管理端口；只监听 127.0.0.1。
# 可以指定单端口、端口段或 0（由系统分配）；单端口只能供一个任务占用。
LIEBIAN_API_PORT_RANGE=43188-43287
# 容器启动后等待运行时通过身份校验的最长时间（毫秒）。
LIEBIAN_TASK_START_TIMEOUT_MS=60000
# 可选：目标能访问到的宿主机 IP/域名，提供给执行者。监听端口由 work 自行选择。
LIEBIAN_CALLBACK_HOST=
# 使用域名/反向代理时可覆盖控制台显示地址及允许来源。
# LIEBIAN_WEB_PUBLIC_URL=http://127.0.0.1:43187
# LIEBIAN_WEB_ALLOWED_ORIGINS=https://console.example.com

# 构建镜像时的网络选项（国内网络按需启用）。
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# NPM_REGISTRY=https://registry.npmmirror.com
# DOCKER_CLI_IMAGE=docker.m.daocloud.io/library/docker:27-cli
